<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Profile - DHMP Agbor</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="dashboard-body">

  <div class="dashboard-layout">
    
    <aside class="sidebar">
      <div class="sidebar-logo">
        <a href="/">
          <img src="/images/dashboardlogo.svg" alt="DHMP Agbor Logo">
        </a>
      </div>
      
      <ul class="sidebar-menu">
        <li><a href="/dashboard"><i class="fas fa-th-large"></i> Overview</a></li>
        <li><a href="/booking"><i class="fas fa-calendar-plus"></i> Book Appointment</a></li>
        <li><a href="/history"><i class="fas fa-history"></i> View History</a></li>
      </ul>

      <div class="sidebar-bottom">
        <ul class="sidebar-menu">
          <li class="active"><a href="/account"><i class="fas fa-user"></i> Account</a></li>
          <li><a href="/settings"><i class="fas fa-cog"></i> Settings</a></li>
          <li><a href="/login" class="logout"><i class="fas fa-sign-out-alt"></i> Log Out</a></li>
        </ul>
      </div>
    </aside>

    <main class="dashboard-content">
      
      <header class="dashboard-header">
        <div class="profile-shortcut">
          <div class="profile-pic">
            <!-- FIXED: Top right profile picture is now dynamic -->
            <img src="<%= user.profile_pic || '/images/profilepic.png' %>" alt="Profile">
          </div>
        </div>
      </header>

      <div class="page-title">
        <h1>Patient Profile</h1>
        <p>Manage your personal information and view your medical demographics.</p>
      </div>

      <div class="profile-container">
        
        <div class="profile-side-card">
          <div class="profile-avatar-large">
            <!-- FIXED: Main profile picture is now dynamic -->
            <img src="<%= user.profile_pic || '/images/profilepic.png' %>" alt="<%= user.full_name %>">
            <!-- Changed to an anchor tag to link directly to the edit page -->
            <a href="/edit-profile" class="btn-change-photo"><i class="fas fa-camera"></i></a>
          </div>
          <!-- FIXED: Name and Patient ID -->
          <h2 class="patient-name"><%= user.full_name %></h2>
          <div class="patient-id">ID: AGB-2026-<%= user.id %></div>
          
          <div class="patient-contact">
            <p><i class="fas fa-phone-alt"></i> <%= user.phone || 'Not provided' %></p>
            <p><i class="fas fa-envelope"></i> <%= user.email %></p>
          </div>

          <a href="/edit-profile" class="btn-edit-profile" style="display: block; text-align: center; text-decoration: none;"><i class="fas fa-pen"></i> Edit Profile</a>
        </div>

        <div class="profile-main-card">
          
          <div class="info-section">
            <h3><i class="fas fa-address-card"></i> Personal Demographics</h3>
            <div class="info-grid">
              <div class="info-item">
                <label>Date of Birth</label>
                <!-- Formats the raw database date into a readable string like "October 14, 2002" -->
                <p><%= user.dob ? new Date(user.dob).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : 'Not provided' %></p>
              </div>
              <div class="info-item">
                <label>Gender</label>
                <p>Female</p>
              </div>
              <div class="info-item">
                <label>Marital Status</label>
                <p>Single</p>
              </div>
              <div class="info-item">
                <label>Residential Address</label>
                <p><%= user.address || 'Not provided' %></p>
              </div>
              <div class="info-item">
                <label>Emergency Contact Name</label>
                <p><%= user.em_name || 'Not provided' %></p>
              </div>
              <div class="info-item">
                <label>Emergency Phone</label>
                <p><%= user.em_phone || 'Not provided' %></p>
              </div>
            </div>
          </div>

          <div class="info-section" style="margin-top: 40px;">
            <h3><i class="fas fa-notes-medical"></i> Medical Details</h3>
            <!-- These remain static until a medical history table is added later -->
            <div class="info-grid">
              <div class="info-item">
                <label>Blood Group</label>
                <p class="highlight-text">O Positive (O+)</p>
              </div>
              <div class="info-item">
                <label>Genotype</label>
                <p class="highlight-text">AA</p>
              </div>
              <div class="info-item">
                <label>Known Allergies</label>
                <p>None documented</p>
              </div>
              <div class="info-item">
                <label>Chronic Conditions</label>
                <p>None</p>
              </div>
            </div>
          </div>

        </div>

      </div>

    </main>
  </div>
</body>
</html>