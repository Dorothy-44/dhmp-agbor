<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Patient Dashboard - DHMP Agbor</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="dashboard-body">

  <div class="dashboard-layout">
    
    <aside class="sidebar">
      <div class="sidebar-logo">
        <a href="/">
          <img src="/images/dashboardlogo.svg" alt="DHMP Agbor Logo">
        </a>
      </div>
      
      <ul class="sidebar-menu">
        <li class="active"><a href="/dashboard"><i class="fas fa-th-large"></i> Overview</a></li>
        <li><a href="/booking"><i class="fas fa-calendar-plus"></i> Book Appointment</a></li>
        <li><a href="/history"><i class="fas fa-history"></i> View History</a></li>
      </ul>

      <div class="sidebar-bottom">
        <ul class="sidebar-menu">
          <li><a href="/account"><i class="fas fa-user"></i> Account</a></li>
          <li><a href="/settings"><i class="fas fa-cog"></i> Settings</a></li>
          <li><a href="/login" class="logout"><i class="fas fa-sign-out-alt"></i> Log Out</a></li>
        </ul>
      </div>
    </aside>

    <main class="dashboard-content">
      
      <header class="dashboard-header">
        <div class="profile-shortcut">
          <a href="/account" style="text-decoration: none; cursor: pointer;">
            <div class="profile-pic">
              <img src="<%= profilePic || '/images/profilepic.png' %>" alt="Profile">
            </div>
          </a>
        </div>
      </header>

      <section class="dashboard-banner">
        <div class="banner-greeting">
          <h1>Good Morning, <%= patientName %></h1>
          <p>Here is your health overview for today.</p>
        </div>
        <div class="banner-profile">
          <img src="<%= profilePic || '/images/profilepic.png' %>" alt="Large Profile">
        </div>
      </section>

      <div class="dashboard-cards-grid">
        
        <div class="dash-card appointment-card">
          <div class="card-header">
            <h3>Upcoming Appointment <span id="apt-counter" style="font-size: 0.8rem; font-weight: normal; color: #555;"></span></h3>
            <% if (upcomingAppointments && upcomingAppointments.length > 0) { %>
              <span id="apt-status" class="status-badge confirmed"><%= upcomingAppointments[0].status %></span>
            <% } %>
          </div>
          
          <% if (upcomingAppointments && upcomingAppointments.length > 0) { %>
            <div class="appointment-details">
              <div class="detail-row"><i class="fas fa-calendar-day"></i> <strong id="apt-date"><%= upcomingAppointments[0].date %></strong></div>
              <div class="detail-row"><i class="fas fa-clock"></i> <span id="apt-time"><%= upcomingAppointments[0].timeSlot %></span></div>
              <div class="detail-row"><i class="fas fa-user-md"></i> <span id="apt-dept"><%= upcomingAppointments[0].department %></span></div>
              <div class="detail-row"><i class="fas fa-map-marker-alt"></i> <span id="apt-facility"><%= upcomingAppointments[0].facilityName %></span></div>
            </div>
            
            <% if (upcomingAppointments.length > 1) { %>
              <a href="javascript:void(0);" class="btn-arrow-circle" onclick="nextApt()"><i class="fas fa-arrow-right"></i></a>
            <% } %>

          <% } else { %>
            <div class="appointment-details" style="padding: 20px 0;">
              <p class="text-muted">You have no upcoming appointments scheduled.</p>
            </div>
          <% } %>
        </div>

       <script type="application/json" id="aptData">
          <%- JSON.stringify(upcomingAppointments || []) %>
        </script>

        <script>
          // Read the data cleanly from the block above
          const rawData = document.getElementById('aptData').textContent;
          const appointments = JSON.parse(rawData);
          
          let currentIndex = 0;

          function nextApt() {
              if (!appointments || appointments.length <= 1) return; 

              // Move to the next one, loop back to 0 if at the end
              currentIndex = (currentIndex + 1) % appointments.length;
              const apt = appointments[currentIndex];

              // Update the HTML
              document.getElementById('apt-status').innerText = apt.status;
              document.getElementById('apt-date').innerText = apt.date;
              document.getElementById('apt-time').innerText = apt.timeSlot;
              document.getElementById('apt-dept').innerText = apt.department;
              document.getElementById('apt-facility').innerText = apt.facilityName;

              // Update the little counter at the top
              document.getElementById('apt-counter').innerText = `(${currentIndex + 1} of ${appointments.length})`;
          }
        </script>




        <div class="dash-card book-card">
          <div class="book-content">
            <h3>Need to see a doctor?</h3>
            <p>Skip the waiting room queue by scheduling your visit in advance.</p>
            <a href="/booking" class="btn-book">Book New Appointment</a>
          </div>
        </div>
      </div>

      <div class="history-section">
        <h3>Recent Visit History</h3>
        <div class="table-container off-white-card">
          <table class="history-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Department</th>
                <th>Facility</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>May 10, 2026</td>
                <td>Malaria Screening</td>
                <td>Central Hospital</td>
                <td><span class="status-dot completed"></span> Completed</td>
              </tr>
              <tr>
                <td>April 22, 2026</td>
                <td>General Checkup</td>
                <td>Boji-Boji Clinic</td>
                <td><span class="status-dot completed"></span> Completed</td>
              </tr>
              <tr>
                <td>March 05, 2026</td>
                <td>Dental</td>
                <td>Central Hospital</td>
                <td><span class="status-dot completed"></span> Completed</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

    </main>

  </div>
</body>
</html>