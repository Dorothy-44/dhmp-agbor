<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Confirm Appointment - DHMP Agbor</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="dashboard-body">

  <div class="dashboard-layout">
    
    <aside class="sidebar">
      <div class="sidebar-logo">
        <a href="/">
          <img src="/images/dashboardlogo.svg" alt="DHMP Agbor Logo">
        </a>
      </div>
      
      <ul class="sidebar-menu">
        <li><a href="/dashboard"><i class="fas fa-th-large"></i> Overview</a></li>
        <li class="active"><a href="/booking"><i class="fas fa-calendar-plus"></i> Book Appointment</a></li>
        <li><a href="/history"><i class="fas fa-history"></i> View History</a></li>
      </ul>

      <div class="sidebar-bottom">
        <ul class="sidebar-menu">
          <li><a href="/account"><i class="fas fa-user"></i> Account</a></li>
          <li><a href="/settings"><i class="fas fa-cog"></i> Settings</a></li>
          <li><a href="/login" class="logout"><i class="fas fa-sign-out-alt"></i> Log Out</a></li>
        </ul>
      </div>
    </aside>

    <main class="dashboard-content">
      
      <header class="dashboard-header">
        <div class="profile-shortcut">
          <div class="profile-pic">
            <img src="/images/profilepic.png" alt="Profile">
          </div>
        </div>
      </header>

      <div class="page-title">
        <h1>Review Details</h1>
        <p>Please double-check your appointment information before confirming.</p>
      </div>

      <div class="booking-card confirm-card">
        
        <div class="review-header">
          <div class="review-icon">
            <i class="fas fa-clipboard-check"></i>
          </div>
          <h2>Appointment Summary</h2>
        </div>

        <ul class="review-list">
          <li>
            <div class="review-label">Patient Name</div>
            <div class="review-value"><%= patientName %></div>
          </li>
          <li>
            <div class="review-label">Facility</div>
            <div class="review-value text-blue"><%= facility %></div>
          </li>
          <li>
            <div class="review-label">Department</div>
            <div class="review-value"><%= department %></div>
          </li>
          <li>
            <div class="review-label">Date & Time</div>
            <div class="review-value">
              <strong><%= new Date(appointmentDate).toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }) %> at <%= shift %></strong>
            </div>
          </li>
          <li class="full-width">
            <div class="review-label">Reason for Visit</div>
            <div class="review-value box-value"><%= reason %></div>
          </li>
        </ul>

        <div class="summary-note">
          <i class="fas fa-info-circle"></i> 
          <span>Please ensure you arrive at least 15 minutes before your scheduled time slot to complete any necessary paperwork. <strong>Come with your hospital card if you have or the sum of ₦500 if you don't.</strong></span>
        </div>

        <div class="form-actions">
          <a href="/booking" class="btn-cancel"><i class="fas fa-arrow-left"></i> Edit Details</a>
          
          <form action="/api/book-appointment" method="POST" style="margin: 0; padding: 0; display: inline;">
            <input type="hidden" name="facility" value="<%= facility %>">
            <input type="hidden" name="department" value="<%= department %>">
            <input type="hidden" name="appointmentDate" value="<%= appointmentDate %>">
            <input type="hidden" name="shift" value="<%= shift %>">
            <input type="hidden" name="reason" value="<%= reason %>">
            
            <button type="submit" class="btn-book-submit" style="border: none; cursor: pointer;">Confirm & Book Now</button>
          </form>

        </div>

      </div>

    </main>
  </div>
</body>
</html>