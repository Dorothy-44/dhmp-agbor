<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Forgot Password - DHMP Agbor</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="auth-body">

  <div class="auth-container">
    <div class="auth-card">
      
      <div class="auth-header">
        <a href="/">
          <img src="/images/dashboardlogo.svg" alt="DHMP Agbor Logo" class="auth-logo">
        </a>
        <h1>Reset Password</h1>
        <p>For security verification, enter your registered email address along with your new password to update your credentials immediately.</p>
      </div>

      <form action="/api/reset-password" method="POST" class="auth-form">
        
        <div class="input-group">
          <label for="reset-email">Registered Email Address</label>
          <div class="input-with-icon">
            <i class="fas fa-envelope"></i>
            <input type="email" id="reset-email" name="email" placeholder="e.g., faithosadiaye@gmail.com" required>
          </div>
        </div>

        <div class="input-group">
          <label for="new-password">New Password</label>
          <div class="input-with-icon">
            <i class="fas fa-lock"></i>
            <input type="password" id="new-password" name="newPassword" placeholder="Enter your new password" required>
          </div>
        </div>

        <button type="submit" class="btn-auth-submit">Update Password</button>

      </form>

      <div class="auth-footer">
        <p>Remember your password? <a href="/login">Log in here</a></p>
      </div>

    </div>
  </div>

</body>
</html>