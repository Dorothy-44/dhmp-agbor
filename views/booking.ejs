<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Book Appointment - DHMP Agbor</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="dashboard-body">

  <div class="dashboard-layout">
    
    <aside class="sidebar">
      <div class="sidebar-logo">
        <a href="/">
          <img src="/images/dashboardlogo.svg" alt="DHMP Agbor Logo">
        </a>
      </div>
      
      <ul class="sidebar-menu">
        <li><a href="/dashboard"><i class="fas fa-th-large"></i> Overview</a></li>
        <li class="active"><a href="/booking"><i class="fas fa-calendar-plus"></i> Book Appointment</a></li>
        <li><a href="/history"><i class="fas fa-history"></i> View History</a></li>
      </ul>

      <div class="sidebar-bottom">
        <ul class="sidebar-menu">
          <li><a href="/account"><i class="fas fa-user"></i> Account</a></li>
          <li><a href="/settings"><i class="fas fa-cog"></i> Settings</a></li>
          <li><a href="/login" class="logout"><i class="fas fa-sign-out-alt"></i> Log Out</a></li>
        </ul>
      </div>
    </aside>

    <main class="dashboard-content">
      <header class="dashboard-header">
        <div class="profile-shortcut">
          <a href="/account" style="text-decoration: none; cursor: pointer;">
            <div class="profile-pic">
              <img src="<%= profilePic || '/images/profilepic.png' %>" alt="Profile">
            </div>
          </a>
        </div>
      </header>



      <div class="page-title">
        <h1>Schedule a Visit</h1>
        <p>Fill out the details below to book your appointment with our healthcare professionals.</p>
      </div>

      <div class="booking-card">
        <form action="/confirm" method="POST" class="booking-form">
          
          <div class="form-section-title">1. Patient Verification</div>
          <div class="input-group">
            <label for="userEmail">Confirm Your Registered Email</label>
            <input type="email" id="userEmail" name="userEmail" placeholder="Enter the email you used to log in" required>
          </div>

          <div class="form-section-title" style="margin-top: 20px;">2. Where do you need to go?</div>
          <div class="form-row">
            <div class="input-group">
              <label for="facility">Preferred Facility</label>
              <select id="facility" name="facility" required>
                <option value="" disabled selected>Select a hospital or clinic</option>
                <option value="Central Hospital Agbor">Central Hospital Agbor</option>
                <option value="Owa-alero Government Hospital">Owa-Alero Government Hospital</option>
                <option value="Agbor-Obi Primary Health Centre">Agbor-Obi Primary Health Centre</option>
              </select>
            </div>
            <div class="input-group">
              <label for="department">Medical Department</label>
              <select id="department" name="department" required>
                <option value="" disabled selected>Select a department</option>
                <option value="General Practice">General Practice</option>
                <option value="Maternity">Maternity & Antenatal</option>
                <option value="Pediatrics">Pediatrics (Children)</option>
              </select>
            </div>
          </div>

          <div class="form-section-title">3. When are you available?</div>
          <div class="form-row">
            <div class="input-group">
              <label for="date">Preferred Date</label>
              <input type="date" id="date" name="appointmentDate" required>
            </div>
            
            <div class="input-group">
              <label>Available Slots</label>
              <div class="time-slots-grid">
                <label class="time-slot">
                  <input type="radio" name="shift" value="Morning" required>
                  <span>09:00 AM</span>
                </label>
                <label class="time-slot">
                  <input type="radio" name="shift" value="Morning">
                  <span>10:30 AM</span>
                </label>
                <label class="time-slot">
                  <input type="radio" name="shift" value="Afternoon">
                  <span>12:00 PM</span>
                </label>
                <label class="time-slot">
                  <input type="radio" name="shift" value="Afternoon">
                  <span>01:30 PM</span>
                </label>
                <label class="time-slot">
                  <input type="radio" name="shift" value="Afternoon">
                  <span>03:00 PM</span>
                </label>
                <label class="time-slot">
                  <input type="radio" name="shift" value="Evening">
                  <span>04:30 PM</span>
                </label>
              </div>
            </div>
          </div>

          <div class="form-section-title">4. Briefly describe your symptoms</div>
          <div class="input-group">
            <label for="reason">Reason for Appointment</label>
            <textarea id="reason" name="reason" rows="4" placeholder="E.g., Routine checkup, experiencing fever..." required></textarea>
          </div>

          <div class="form-actions">
            <button type="button" class="btn-cancel" onclick="window.history.back()">Cancel</button>
            <button type="submit" class="btn-book-submit">Book Appointment</button>
          </div>

        </form>
      </div>

    </main>
  </div>
</body>
</html>