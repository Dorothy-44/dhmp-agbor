<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>View History - DHMP Agbor</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="dashboard-body">

  <div class="dashboard-layout">
    
    <aside class="sidebar">
      <div class="sidebar-logo">
        <a href="/">
          <img src="/images/dashboardlogo.svg" alt="DHMP Agbor Logo">
        </a>
      </div>
      
      <ul class="sidebar-menu">
        <li><a href="/dashboard"><i class="fas fa-th-large"></i> Overview</a></li>
        <li><a href="/booking"><i class="fas fa-calendar-plus"></i> Book Appointment</a></li>
        <li class="active"><a href="/history"><i class="fas fa-history"></i> View History</a></li>
      </ul>

      <div class="sidebar-bottom">
        <ul class="sidebar-menu">
          <li><a href="/account"><i class="fas fa-user"></i> Account</a></li>
          <li><a href="/settings"><i class="fas fa-cog"></i> Settings</a></li>
          <li><a href="/login" class="logout"><i class="fas fa-sign-out-alt"></i> Log Out</a></li>
        </ul>
      </div>
    </aside>

    <main class="dashboard-content">
      
      <header class="dashboard-header">
        <div class="profile-shortcut">
          <a href="/account" style="text-decoration: none; cursor: pointer;">
            <div class="profile-pic">
              <img src="<%= profilePic || '/images/profilepic.png' %>" alt="Profile">
            </div>
          </a>
        </div>
      </header>

      <div class="page-header-flex">
        <div class="page-title">
          <h1>Medical Visit History</h1>
          <p>Review your past appointments, facility visits, and consultation records.</p>
        </div>
        <a href="#" class="btn-download"><i class="fas fa-download"></i> Download Records</a>
      </div>

      <div class="history-filters">
        <div class="filter-group">
          <label for="filter-year">Year</label>
          <select id="filter-year">
            <option value="2026">2026</option>
            <option value="all">All Time</option>
          </select>
        </div>
        <div class="filter-group">
          <label for="filter-facility">Facility</label>
          <select id="filter-facility">
            <option value="all">All Facilities</option>
            <option value="central">Central hospital Agbor</option>
            <option value="boji">Owa-alero Government Hospital</option>
            <option value="owa">Agbor-obi primary health centre</option>
          </select>
        </div>
        <button class="btn-filter">Apply Filter</button>
      </div>

      <div class="table-container off-white-card full-history-table">
        <table class="history-table">
          <thead>
            <tr>
              <th>Date & Time</th>
              <th>Doctor</th>
              <th>Department</th>
              <th>Facility</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% if (typeof historyData !== 'undefined' && historyData.length > 0) { %>
              <% historyData.forEach(function(apt) { %>
                <tr>
                  <td>
                    <strong><%= new Date(apt.appointment_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></strong><br>
                    <span class="text-sm"><%= apt.shift %></span>
                  </td>
                  <td>Assigned Medical Officer</td>
                  <td><%= apt.department %></td>
                  <td>DHMP Facility</td>
                  <td>
                    <% if (apt.status === 'Completed') { %>
                      <span class="status-dot completed"></span> Completed
                    <% } else if (apt.status === 'Pending') { %>
                      <span class="status-dot" style="background-color: #f59e0b; display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 5px;"></span> Pending
                    <% } else if (apt.status === 'Approved') { %>
                      <span class="status-dot" style="background-color: #3b82f6; display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 5px;"></span> Approved
                    <% } else { %>
                      <span class="status-dot cancelled"></span> <%= apt.status %>
                    <% } %>
                  </td>
                  <td><a href="#" class="action-link">View Notes</a></td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="6" style="text-align: center; padding: 30px; color: #6c757d;">
                  You have no medical history records found.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
        
        <div class="pagination">
          <a href="#" class="page-link disabled"><i class="fas fa-chevron-left"></i> Previous</a>
          <span class="page-info">Page 1 of 1</span>
          <a href="#" class="page-link disabled">Next <i class="fas fa-chevron-right"></i></a>
        </div>
      </div>

    </main>
  </div>
</body>
</html>